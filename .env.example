# Skopiuj do .env i ustaw własne wartości (hasło bazy: litery i cyfry).
POSTGRES_PASSWORD=zmienNaLosoweHasloBazy123
# Minimum 32 znaki; np. wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=zmien-na-losowy-sekret-minimum-32-znaki-przed-uruchomieniem
# Opcjonalny klucz HERE Raster Tile API v3; używany wyłącznie przez backend.
HERE_API_KEY=
# OpenAI: wyłącznie backend, nigdy VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_PLANNER_MODEL=gpt-6.1-terra
OPENAI_RESEARCH_MODEL=gpt-6-luna
OPENAI_CONTACT_MODEL=gpt-6-luna
CONTACT_RESEARCH_AUTOSTART=0
CONTACT_RESEARCH_WORKER=1
PHOTO_RESEARCH_RUN=
PHOTO_RESEARCH_REGION=lubuskie
## Istniejące konta promowane do superadministratora podczas startu API.
SUPERADMIN_EMAILS=
SUPERADMIN_INITIAL_PASSWORD=
