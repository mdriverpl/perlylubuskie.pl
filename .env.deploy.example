# Skopiuj do .env NA SERWERZE i ustaw własne losowe wartości.
# POSTGRES_PASSWORD: litery i cyfry, bez znaków specjalnych w URL połączenia.
POSTGRES_PASSWORD=UZUPELNIJ_LOSOWE_HASLO_BAZY
# Minimum 32 znaki. Przykład generowania na Linuxie: openssl rand -hex 48
SECRET_KEY=UZUPELNIJ_LOSOWY_SEKRET_MINIMUM_32_ZNAKI
PUBLIC_URL=http://localhost:8080
APP_BIND=0.0.0.0
APP_PORT=8080
IMAGE_PREFIX=ghcr.io/mdriverpl/perlylubuskie
# latest lub pełny SHA konkretnego commita z GitHub Actions.
IMAGE_TAG=latest
## Istniejące konta promowane do superadministratora podczas startu API.
SUPERADMIN_EMAILS=
SUPERADMIN_INITIAL_PASSWORD=
OPENAI_MODEL=gpt-6-luna
OPENAI_PLANNER_MODEL=gpt-6.1-terra
OPENAI_RESEARCH_MODEL=gpt-6-luna
OPENAI_CONTACT_MODEL=gpt-6-luna
CONTACT_RESEARCH_AUTOSTART=0
CONTACT_RESEARCH_WORKER=1
PHOTO_RESEARCH_RUN=
PHOTO_RESEARCH_REGION=lubuskie
